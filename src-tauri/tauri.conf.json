{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "파일 정리 도우미",
  "mainBinaryName": "file-organizer",
  "version": "../package.json",
  "identifier": "com.hwichemi.file-organizer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "파일 정리 도우미",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "center": true
      },
      {
        "label": "popup",
        "title": "새 파일",
        "width": 460,
        "height": 640,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "파일 정리 도우미",
    "shortDescription": "새 파일을 원하는 폴더로 정리해 주는 프로그램",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1QUUzMzdDMDRCRjJDNDIKUldSQ0xMOEVmRE91dFIxQS9IVW1wOWFhdjk5RDZZVmFEVUV5TWlRQlRXdWxISDFqVGVEZm1ORloK",
      "endpoints": [
        "https://github.com/08hwichemi/file-organizer-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
